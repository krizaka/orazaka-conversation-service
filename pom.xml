<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.krizaka.orazaka</groupId>
        <artifactId>orazaka-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../../orazaka-libs/orazaka-build/orazaka-parent/pom.xml</relativePath>
    </parent>

    <artifactId>orazaka-conversation-service</artifactId>
    <name>orazaka-conversation-service</name>
    <description>Orazaka Conversation Service — interactive host (ex-router): HTTP/SSE ingress, job submission and SSE relay</description>

    <url>https://github.com/krizaka/orazaka-conversation-service</url>

    <scm>
        <url>https://github.com/krizaka/orazaka-conversation-service</url>
        <connection>scm:git:https://github.com/krizaka/orazaka-conversation-service.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/orazaka-conversation-service.git</developerConnection>
    </scm>

    <properties>
        <!-- GitHub Packages repository this artifact is published to (orazaka-parent). -->
        <orazaka.repository>orazaka-conversation-service</orazaka.repository>
    </properties>


    <dependencies>
        <!-- Krizaka platform kit: session-JWT security baseline and service-to-service tokens. -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-security</artifactId>
        </dependency>
        <!-- The users service's internal API, typed (UserDirectoryClient). -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-users-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-assets</artifactId>
        </dependency>
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-billing-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring Boot 4 decoupled RestClient from spring-boot-starter-web: RestClientAutoConfiguration
             (the RestClient.Builder bean injected by core/tools — WhisperTranscriptionClient,
             OllamaModelCatalogProvider, VideoGeneratorClientImpl, DefaultMcpOrchestrator) now lives in
             the spring-boot-restclient module, pulled by this starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <!-- Internal Dependencies -->
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-core</artifactId>
        </dependency>
        <!-- Phase 2 cutover: the identity LIBRARY left this process - only the principal
             contract (User/UserProfile/RateLimitInfo + shared exceptions) remains; identity
             data is reached over the service's internal API (HttpUserDirectoryAdapter). -->
        <dependency>
            <groupId>com.krizaka</groupId>
            <artifactId>krizaka-users-api</artifactId>
        </dependency>

        <!-- Tier-1 job-plane contract: the JobCommand wire record this service publishes. One
             definition, shared with the executor that deserialises it (ADR-037, audit #17). -->
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-jobs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-business</artifactId>
        </dependency>
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-persistence-app</artifactId>
        </dependency>
        <!-- Bridge: core DB-backed outbound ports (CapabilityProvider, PipelineConfigProvider, …)
             implemented against the persistence inbound ports. Shared with job-service so neither
             re-implements the same DB adapters. -->
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-persistence-bridge</artifactId>
        </dependency>


        <!-- ADR-030: Spring AI provider STARTERS removed. No autoconfigured Ollama/OpenAI
             beans — model clients are built programmatically from the DB (ai_providers +
             orazaka_models) by the Dynamic Model Router / Universal Proxy Client in
             orazaka-core. The `spring-ai-ollama` / `spring-ai-openai` model libraries
             (the builder classes) are pulled transitively via orazaka-core. -->

        <!-- RabbitMQ AMQP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Rate Limiting Dependencies -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-lettuce</artifactId>
            <version>8.18.0</version>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>

        <!-- Actuator, AOP and Resilience4j -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Distributed tracing (Phase 0 observability baseline): Micrometer Tracing over the
             OpenTelemetry bridge, exported OTLP/HTTP to the local Jaeger container (:4318).
             AMQP template/listener observation propagates traceparent across the broker. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Spring Boot 4 removed spring-boot-starter-aop (GA); AspectJ weaver is BOM-managed
             and AopAutoConfiguration (core) enables @Aspect proxying when it is present. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-test-support</artifactId>
        </dependency>
        <!-- Interceptor pipeline (single module — packages by concern: context, enrichment,
             reformulation, tooling, translation, validation, governance). Registered via
             @AutoConfiguration SPI from META-INF/spring imports; @ConditionalOnBean guards
             ensure graceful degradation when upstream ports (ChatModel, ToolRegistry...) absent. -->
        <dependency>
            <groupId>com.krizaka.orazaka</groupId>
            <artifactId>orazaka-interceptors</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
